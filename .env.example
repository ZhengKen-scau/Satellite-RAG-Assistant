# Satellite RAG Assistant - 环境变量示例
# 复制此文件为 .env 并填入实际值

# Ollama配置（本地大模型）
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:3b
# 可选模型: llama3.2:3b

# 嵌入模型配置
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# 向量数据库配置
CHROMA_DB_PATH=./storage/chroma_db

# 文档处理配置
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# 缓存配置
CACHE_DIR=./storage/cache
CACHE_TTL=3600